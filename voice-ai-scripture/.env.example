# Groq Cloud Whisper API Key for ultra-low-latency (~300ms) transcription (Recommended)
# Get a free key at: https://console.groq.com/keys
EXPO_PUBLIC_GROQ_API_KEY=

# OpenAI API Key for speech transcription (gpt-transcribe / whisper-1)
# When omitted and no Groq key is set, the app attempts on-device native speech recognition.
EXPO_PUBLIC_OPENAI_API_KEY=
